    {
      "id": "d06ff1f9-5825-49c5-99b2-fed98a33e076",
      "name": "Classificar solicitação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "const b=$('Webhook Astros').first().json.body;\nconst user=$('Validar sessão').first().json;\nconst records=name=>$(name).all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]);\nconst error=message=>[{json:{route:'error',success:false,message}}];\nconst normalize=value=>{let n=String(value||'').replace(/\\D/g,'');return n.startsWith('55')&&[12,13].includes(n.length)?n.slice(2):n;};\nconst number=normalize(b.number);\nif(!user.id||!user.email_confirmed_at)return error('Confirme seu e-mail e entre novamente.');\nif(!['quote','submit'].includes(b.action)||!/^\\d{10,11}$/.test(number)||!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(b.requestId||''))return error('Confira os dados da solicitação.');\nconst profile=records('Consultar perfil').find(p=>p.id===user.id);\nif(!profile)return error('Conta não encontrada.');\nconst previous=records('Consultar referência').find(p=>p.id===b.requestId);\nif(previous){if(previous.user_id!==user.id||previous.number!==number)return error('Referência divergente.');return [{json:{route:'error',...(previous.result||{success:false,state:previous.state,message:'Esta referência já está em processamento ou aguardando conferência. Não crie outro envio.'})}}];}\nconst matches=records('Consultar números').filter(r=>r.id&&normalize(r.numero)===number);\nif(matches.length>1)return error('Há mais de um registro deste número. Entre em contato com o suporte.');\nconst row=matches[0];\nif(row&&String(row.email||'').trim().toLowerCase()!==String(user.email).trim().toLowerCase())return error('Este número não está vinculado à sua conta. Entre em contato com o suporte.');\nconst current=row?.excluido_da_base?.value;\nif(row&&!['EXCLUIDO','ANÁLISE NEGADA','DESBANIMENTO OK','EM ANÁLISE PELA META','REEDESBANIMENTO'].includes(current))return error('O status deste número precisa ser conferido pelo suporte.');\nconst kind=!row?'new':current==='EXCLUIDO'?'renew':'resend';\nconst price=Number(records('Consultar taxa')[0]?.service_price_cents);\nconst costCents=kind==='resend'?0:price;\nif(!Number.isSafeInteger(costCents)||costCents<0||(kind!=='resend'&&costCents===0))return error('A taxa do serviço ainda não está configurada.');\nconst targetStatus=kind==='resend'?'REEDESBANIMENTO':'EM ANÁLISE PELA META';\nif(b.action==='submit'&&b.expectedCents!==costCents)return error('O valor ou a situação do número mudou. Consulte novamente antes de confirmar.');\nconst stamp=$now.setZone('America/Fortaleza').toFormat('dd/MM/yyyy HH:mm');\nconst observations=(row?.observacoes?row.observacoes+'\\n':'')+`Painel Astros - ${stamp} - ${kind} [ASTROS:${b.requestId}]`;\nreturn [{json:{route:b.action==='quote'?'quote':'submit',success:true,state:'quoted',number,kind,targetStatus,costCents,userId:user.id,email:user.email,nome:profile.nome,rowId:row?.id||null,observations,stamp,message:costCents===0?'Reenvio sem nova cobrança.':'A taxa será descontada do saldo ao confirmar.'}}];"
      }
    },
